{
  "name": "by-eds-saha-programi",
  "version": "16.34.0",
  "description": "BY EDŞ Saha Programı",
  "author": "Bayram YARAŞ",
  "main": "main.js",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.js",
    "dist": "npm run prepare:assets && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "37.2.6",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.bayramyaras.byedssaha",
    "productName": "BY EDŞ Saha Programı",
    "copyright": "Copyright © 2026 Bayram YARAŞ",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "assets/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icons/icon.ico",
      "artifactName": "BY_EDS_Saha_Programi_v16.34_SETUP.${ext}",
      "executableName": "BY_EDS_Saha",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "BY EDŞ Saha Programı",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "BY_EDS_Saha_Programi_v16.34_SETUP.${ext}"
    },
    "extraMetadata": {
      "companyName": "Bayram YARAŞ"
    }
  }
}
